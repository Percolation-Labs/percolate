# Builds percolate_parser.so for ONE platform. Run it once per architecture.
#
# Self-contained on purpose. This used to be `FROM pg19-stack-db:latest` -- a
# LOCAL tag produced by Dockerfile.pg19, which needs dist/percolate_parser.so,
# which is what this file produces. The cycle was invisible on a machine that
# had already built everything once and fatal on any other, including a CI
# runner. Starting from the public base breaks it, and is also what lets
# `--platform linux/amd64` work: the toolchain is installed for whatever
# platform the build is running as, rather than inherited from whatever was
# lying around.
FROM postgres:19beta3-bookworm

# THE pgrx PIN COMES IN, from the one place that declares it: `pgrx` in
# extension/percolate_parser/Cargo.toml. cargo-pgrx (the build tool) and pgrx
# (the crate) must be the same version -- a mismatch fails inside `cargo pgrx
# package` naming neither of them -- and this number had four independent
# spellings: the crate, this line, get-percolate's parser.yml (under a comment
# calling itself "one home for the pgrx pin") and a comment in
# parser-tests.yml. dev/build-image.sh reads Cargo.toml and passes it.
#
# NO DEFAULT, deliberately. A default is a second home that is only ever used
# when somebody forgot to pass the first, which is exactly when it is wrong and
# exactly when nobody is looking -- the build would succeed and the .so would be
# compiled by a toolchain the crate does not depend on.
#
# CHECKED HERE, before apt and rustup, because a refusal four minutes into a
# build gets read as a build failure. This one is immediate and says what to do.
ARG PGRX_VERSION
RUN [ -n "$PGRX_VERSION" ] || { \
      echo "PGRX_VERSION is not set -- it is the pgrx version in" >&2; \
      echo "extension/percolate_parser/Cargo.toml. Run dev/build-image.sh," >&2; \
      echo "which reads it, or pass --build-arg PGRX_VERSION=<that version>." >&2; \
      exit 1; }

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl build-essential pkg-config libssl-dev clang libclang-dev \
    git ca-certificates postgresql-server-dev-19 \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
RUN cargo install --locked cargo-pgrx --version "$PGRX_VERSION"

WORKDIR /work
