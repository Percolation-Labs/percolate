# Experimental PG19-beta stack for validating specs/ against reality.
# Adapted from ../../../p8k8/docker/Dockerfile.pg18 (precedent, per
# meta/skills/spec-driven-development §5 — reuse the working pattern rather
# than inventing a new one).

# TWO STAGES, AND THE REASON IS THE PULL.
#
# The compiler used to ship. `apt-get install build-essential git
# postgresql-server-dev-19` is a 995 MB layer, it was never removed, and what it
# produces is four megabytes: pgvector 1.87 MB, pg_cron 578 kB, the parser .so
# 1.74 MB. So the published image was 1.94 GB to deliver 4 MB of extensions, and
# every user paid that on `docker compose up` — which INSTALL.md calls the whole
# install.
#
# Measured with `docker history` before changing anything. The builder below is
# the old single stage unchanged; the runtime stage is the stock base image plus
# the artefacts, staged through DESTDIR so each project installs wherever it
# means to and nothing here has to enumerate paths upstream may move.
FROM postgres:19beta3-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential git postgresql-server-dev-19 ca-certificates \
    curl pkg-config \
    && rm -rf /var/lib/apt/lists/*

# pgvector — core per meta/postgres-manifest.md
# NOTE: v0.8.1 (what ../../../p8k8/docker/Dockerfile.pg18 pins) fails to build
# against PG19 beta headers (LWLock/slock_t/ConditionVariable missing from
# hnsw.c's include chain) - trying latest tag instead.
#
# OPTFLAGS="" IS NOT A TUNING CHOICE, it is what makes the published image
# runnable. pgvector's Makefile defaults to `-march=native`, so a build compiles
# for the CPU it happens to be built ON. That is right for a laptop build and
# catastrophic for a published image: CI builds arm64 on GitHub's Neoverse
# runners, which have SVE, and Apple Silicon does not implement SVE -- so the
# v0.1.0 image crashed the backend with `signal 4: Illegal instruction` on the
# first `<=>` on every Mac. An INSERT of a vector worked; only the distance
# function carried the instructions, so the failure arrived at query time.
#
# Nothing in CI would have caught it. The image builds, the extension installs,
# `surface.sql` passes, and the crash needs a CPU different from the builder's
# -- which is every user's. Found by pulling the published image onto the
# machine this was developed on and running the sample corpus.
RUN cd /tmp && git clone --branch v0.8.6 https://github.com/pgvector/pgvector.git \
    && cd pgvector && make OPTFLAGS="" && make install DESTDIR=/out && rm -rf /tmp/pgvector

# pg_cron — core per meta/postgres-manifest.md, and the driver behind
# workflow.tick() (workflow-engine/schema.sql §19).
#
# RESOLVED (was: "fails to build against PG19 beta3, not root-caused"). It was
# never a header-ordering interaction with <assert.h>: pg_cron's Makefile pins
# -std=c99, and PG19's StaticAssertExpr() needs C11's `static_assert`. Three
# lines, all recorded with their reasoning in patches/pg_cron-pg19.patch.
#
# Applied as a patch rather than a fork so the delta stays visible and this
# whole block disappears the day upstream supports PG19.
COPY patches/pg_cron-pg19.patch /tmp/
RUN cd /tmp && git clone --branch v1.6.7 https://github.com/citusdata/pg_cron.git \
    && cd pg_cron && git apply /tmp/pg_cron-pg19.patch \
    && make && make install DESTDIR=/out && rm -rf /tmp/pg_cron /tmp/pg_cron-pg19.patch

# pg_partman — core per meta/postgres-manifest.md — untested pending the above.
# RUN cd /tmp && git clone --branch v5.2.4 https://github.com/pgpartman/pg_partman.git \
#     && cd pg_partman && make && make install && rm -rf /tmp/pg_partman

# pgcrypto and pg_trgm are contrib modules — already built into the base image,
# just need CREATE EXTENSION at init time (see init/*.sql).

# ---------------------------------------------------------------------------
# The image users actually pull: the stock base, plus four megabytes.
#
# DESTDIR staging is what makes this safe to write blind. `make install
# DESTDIR=/out` puts every file under /out at the path it would otherwise have
# taken, so copying /out over / reproduces exactly what the single-stage build
# produced — including anything upstream adds later that a hand-written file
# list would miss (pg_cron's bitcode directory is the current example).
# ---------------------------------------------------------------------------
FROM postgres:19beta3-bookworm

COPY --from=builder /out/ /

# ---------------------------------------------------------------------------
# The two Percolate extensions, baked in.
#
# This is why a user needs no Dockerfile: they pull this image and run
# `docker compose up`. The build step exists -- a Rust .so has to be compiled
# for this PG version and architecture -- it just is not theirs.
#
# percolate_parser is built by Dockerfile.pgrx-builder and copied in;
# percolate is pure SQL generated from specs/ by
# extension/percolate/build-sql.py.
# ---------------------------------------------------------------------------
# TARGETARCH is set by buildx per platform ("amd64" / "arm64"), so one
# Dockerfile produces a real multi-arch image. A shared library cannot be
# multi-arch inside one file -- it is compiled against one ABI -- so the .so is
# named per platform and the right one is selected here. Getting this wrong is
# not subtle at runtime, but it IS subtle at build time: a single-arch image
# built on an Apple laptop and pushed as `19` runs nowhere in a typical amd64
# cluster, which is how this image spent its first release arm64-only.
ARG TARGETARCH
COPY dist/percolate_parser-${TARGETARCH}.so /usr/lib/postgresql/19/lib/percolate_parser.so
# Globbed rather than named, so a version bump does not have to be remembered
# here as well. The control files carry the version Postgres will install; the
# script filenames only have to match them, and build-image.sh (or CI) is what
# puts the matching pair in dist/. A stale extra script in dist/ would be
# copied too -- which is why the bump script deletes the old one rather than
# leaving it for a glob to find.
COPY dist/percolate_parser.control dist/percolate_parser--*.sql \
     dist/percolate.control dist/percolate--*.sql \
     /usr/share/postgresql/19/extension/

# The bootstrap, so `docker run` gives a system rather than an empty database
# with an available extension. See the file for why it is shell and not SQL,
# and for why dev/'s bind mount shadows it rather than colliding with it.
# What this image was built from. Not in the extension directory: it is not
# part of the extension, it is a statement about this build of it.
COPY dist/percolate-build.sql /usr/local/share/percolate/build.sql
COPY image-init/00-percolate.sh /docker-entrypoint-initdb.d/00-percolate.sh
