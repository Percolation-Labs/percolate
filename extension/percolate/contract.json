                },
                "node_id": {
                  "format": "uuid",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "node_id"
              ],
              "type": "object"
            }
          ]
        },
        "type": "array"
      },
      "title": "One entry of agentic.messages.citations"
    },
    {
      "consumed_by": [
        "specs/world-model-ingestion/reference/connector.py apply_auth"
      ],
      "implemented": {
        "basic": false,
        "bearer": true,
        "header": true,
        "none": true,
        "oauth2_cc": false,
        "query_param": true,
        "signed": false,
        "user_agent": true
      },
      "name": "content.connector.auth",
      "owner": "world-model-ingestion",
      "schema": {
        "not": {
          "anyOf": [
            {
              "required": [
                "value"
              ]
            },
            {
              "required": [
                "secret"
              ]
            },
            {
              "required": [
                "token"
              ]
            }
          ]
        },
        "properties": {
          "credential_ref": {
            "description": "A NAME. The trigger refuses a row carrying `value`, `secret` or `token`.",
            "type": "string"
          },
          "header": {
            "description": "Header name, for type=header.",
            "type": "string"
          },
          "param": {
            "description": "Query parameter name, for type=query_param.",
            "type": "string"
          },
          "template": {
            "description": "For type=user_agent -- SEC requires an identifying UA, which is a credential.",
            "type": "string"
          },
          "type": {
            "enum": [
              "none",
              "user_agent",
              "header",
              "bearer",
              "query_param",
              "basic",
              "oauth2_cc",
              "signed"
            ],
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "title": "The auth block of a content.connectors row"
    },
    {
      "consumed_by": [
        "specs/world-model-ingestion/reference/connector.py next_page"
      ],
      "implemented": {
        "etag": false,
        "high_water": false,
        "link_header": true,
        "next_url": true,
        "none": true,
        "offset": true,
        "page": true,
        "page_token": true,
        "sequence": false
      },
      "name": "content.connector.paging",
      "owner": "world-model-ingestion",
      "schema": {
        "properties": {
          "field": {
            "description": "Dotted path to the cursor in the body, for next_url and page_token.",
            "type": "string"
          },
          "param": {
            "description": "Query parameter carrying the cursor, for page_token, offset and page.",
            "type": "string"
          },
          "size": {
            "description": "Page size, for offset and page. Defaults to the first page's record count.",
            "minimum": 1,
            "type": "integer"
          },
          "start": {
            "default": 0,
            "type": "integer"
          },
          "type": {
            "enum": [
              "none",
              "link_header",
              "next_url",
              "page_token",
              "offset",
              "page",
              "high_water",
              "sequence",
              "etag"
            ],
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "title": "The paging block of a content.connectors row"
    },
    {
      "consumed_by": [
        "percolate_core.ingest.policy.IngestPolicy",
        "content.merge_policy",
        "content.record_ingest"
      ],
      "implemented": null,
      "name": "content.ingest_policy",
      "owner": "world-model-ingestion",
      "schema": {
        "additionalProperties": false,
        "properties": {
          "chunking": {
            "additionalProperties": false,
            "properties": {
              "min_chars": {
                "default": 120,
                "minimum": 0,
                "type": "integer"
              },
              "overlap": {
                "default": 0.08,
                "minimum": 0,
                "type": "number"
              },
              "target_tokens": {
                "default": 700,
                "maximum": 8000,
                "minimum": 32,
                "type": "integer"
              },
              "tokenizer": {
                "default": "estimate",
                "description": "`estimate` is characters/4 -- offline, identical on every machine, never reaches the network. `tiktoken:<encoding>` DOWNLOADS its encoding on first use, which is a bad thing to discover inside a chunker in a container with no egress.",
                "pattern": "^(estimate|tiktoken:[A-Za-z0-9_]+)$",
                "type": "string"
              }
            },
            "type": "object"
          },
          "keep_markdown": {
            "default": true,
            "type": "boolean"
          },
          "mode": {
            "default": "text",
            "description": "text parses to markdown, chunks and embeds; tabular converts to Parquet and chunks NOTHING; store keeps the bytes and produces no chunks; skip does not even fetch them.",
            "enum": [
              "text",
              "tabular",
              "store",
              "skip"
            ],
            "type": "string"
          },
          "parser": {
            "description": "Which reader. Null takes the family default. The admissible set is the readers INSTALLED in the worker, which is a per-deployment fact -- so this is a hint, not a closed enum, and naming one that cannot read the family is refused at parse time.",
            "type": [
              "string",
              "null"
            ]
          },
          "table": {
            "additionalProperties": false,
            "properties": {
              "delimiter": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "header": {
                "default": true,
                "type": "boolean"
              },
              "mode": {
                "default": "append",
                "enum": [
                  "append",
                  "replace"
                ],
                "type": "string"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "partition_by": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "transcribe": {
            "additionalProperties": false,
            "properties": {
              "credential": {
                "description": "A NAME resolved from the worker's environment, as credential_ref is.",
